# MongoDB Connection URI (Works with local MongoDB and MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/superkingsden?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/superkingsden

# Admin JWT Secret for Authentication (REQUIRED in production).
# Generate a strong value, e.g.:  openssl rand -base64 48
JWT_SECRET=__change_me__generate_a_long_random_secret__

# Optional first-run bootstrap admin. Leave these UNSET once a real AdminUser
# exists in MongoDB. Both must be set for env login to be enabled; there is no
# hardcoded default password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
